# Seedbook environment. In Beachhead, set these in the dashboard with NO Target
# Service so they're written to .env for Docker Compose variable substitution.

# ── Postgres ────────────────────────────────────────────────
# Any strong password. Shared by the postgres service and the backend's
# DATABASE_URL (composed in docker-compose.yml).
DB_PASSWORD=change-me-strong-password

# ── Sessions ────────────────────────────────────────────────
# Long random string used to sign the login cookie. Generate with:
#   openssl rand -hex 32
# Rotating it logs everyone out.
SESSION_SECRET=change-me-openssl-rand-hex-32
# true for HTTPS (Beachhead). Set false only for local plain-HTTP dev.
SESSION_HTTPS_ONLY=true

# ── dry-dock generate API ───────────────────────────────────
# The dry-dock orchestrator's public URL and the DRYDOCK_API_KEY you set on it.
DRYDOCK_BASE_URL=https://drydock.your-domain.com
DRYDOCK_API_KEY=paste-the-key-you-set-on-dry-dock
# Worker pool to use for follow-up generation.
DRYDOCK_POOL=researcher

# ── Resend (reminder emails) ────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender/domain in Resend.
REMINDER_EMAIL_FROM=Seedbook <leads@your-domain.com>
# Where reminders go (you).
REMINDER_EMAIL_TO=you@your-domain.com
# Daily digest schedule (cron) + timezone. Default 9am.
REMINDER_CRON=0 9 * * *
REMINDER_TZ=America/New_Yorkgit
